{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lab-collect",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/backfill",
      "schedule": "0 8 * * *"
    }
  ]
}
