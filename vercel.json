{
  "git": {
    "deploymentEnabled": {
      "claude-code/*": false,
      "ccr-*": false,
      "routine/*": false
    }
  },
  "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then bun run db:migrate; fi && bun run build",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)data/setups'",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/lab-collect",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/backfill",
      "schedule": "0 8 * * *"
    }
  ]
}
