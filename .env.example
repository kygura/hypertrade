# Copy to .env.local for local dev. Names only — never commit values.

# Auth
APP_PASSWORD=          # single login password for the app
SESSION_SECRET=        # HMAC secret for the session cookie

# Database
DATABASE_URL=          # Postgres (Supabase) connection string. Not needed on Vercel if the
                       # Supabase integration is connected: its DATABASE_POSTGRES_URL is used instead.

# Collectors / routine
CRON_TOKEN=            # x-cron-token expected by /api/cron/*
ROUTINE_WEBHOOK_URL=   # POST target for "trigger routine" (optional)
FRED_API_KEY=          # FRED collector API key

# Strategy engine proxy (/api/engine/* -> ${ENGINE_URL}/api/strategy/*)
ENGINE_URL=            # base URL of the hyperion core, e.g. http://localhost:8080 (unset -> 503 engine not configured)
ENGINE_TOKEN=          # bearer token for the core API (optional)

# Analyst (read-only LLM over app data; unset key -> 503 analyst not configured)
# Both providers can be configured at once — the model selector in the
# Analyst page header lets the operator pick per question. ANALYST_PROVIDER
# only names which one is the *server default* (used when a request omits
# `provider`/`model`/`effort`); its own key/base URL still come from the
# legacy ANALYST_API_KEY/ANALYST_BASE_URL below. See README.md "Analyst" for
# the full precedence rules.
ANALYST_PROVIDER=      # anthropic (default) | openai-compatible — which provider is the server default
ANALYST_MODEL=         # model override for the DEFAULT provider only (anthropic id, or the one openai-compatible model when ANALYST_MODELS is unset)
ANALYST_API_KEY=       # DEFAULT provider's key, server-side only
ANALYST_BASE_URL=      # DEFAULT provider's base URL: required if the default is openai-compatible; optional override for anthropic
ANALYST_EFFORT=        # anthropic effort: low|medium|high|xhigh|max (default medium) — server-side fallback when a query doesn't pick one

# Anthropic-specific override: set this to make anthropic selectable even
# when it is NOT the default provider above (lets both providers coexist).
ANALYST_ANTHROPIC_API_KEY=

# openai-compatible-specific overrides: same purpose as ANALYST_ANTHROPIC_API_KEY.
ANALYST_OPENAI_API_KEY=
ANALYST_OPENAI_BASE_URL=
# openai-compatible's selectable model catalog (its own models aren't known
# ahead of time): "id,id2=Label Two,id3". Unset -> falls back to the single
# ANALYST_MODEL value, but only when openai-compatible is the default above.
ANALYST_MODELS=
