# Copy to .env.local for local dev. Names only — never commit values.

# Auth
APP_PASSWORD=          # single login password for the app
SESSION_SECRET=        # HMAC secret for the session cookie

# Database
DATABASE_URL=          # Postgres (Supabase) connection string. Not needed on Vercel if the
                       # Supabase integration is connected: its DATABASE_POSTGRES_URL is used instead.

# Collectors / routine
CRON_TOKEN=            # x-cron-token expected by /api/cron/*
CRON_SECRET=           # Bearer token Vercel Cron sends to /api/cron/* (Vercel reads this exact name)
ROUTINE_WEBHOOK_URL=   # POST target for "trigger routine" (optional)
FRED_API_KEY=          # FRED collector API key
ELFA_API_KEY=          # Elfa social-attention collector (optional; free plan is enough)
ELFA_MIN_INTERVAL_HOURS= # hours between Elfa fetches, default 8 (~90 of the free plan's 1,000 credits/month)

# Strategy engine proxy (/api/engine/* -> ${ENGINE_URL}/api/strategy/*)
ENGINE_URL=            # base URL of the hyperion core, e.g. http://localhost:8080 (unset -> 503 engine not configured)
ENGINE_TOKEN=          # bearer token for the core API (optional)

# Analyst (read-only LLM over app data; nothing configured -> 503 analyst not configured)
# Set any number of provider keys; each one adds that vendor's models to the
# Analyst page's picker. See README.md "Analyst" for the table and overrides.
ANTHROPIC_API_KEY=           # Anthropic: Fable 5.1, Opus 5.5, Sonnet 5.5, Haiku 4.5 (web search); goes first for the Desk
ANALYST_ANTHROPIC_API_KEY=   # same, takes precedence over ANTHROPIC_API_KEY
ANTHROPIC_WORKSPACE_ID=      # required for keys not scoped to a workspace (sk-ant-usr-...)
OPENAI_API_KEY=              # OpenAI: GPT-6 Astra / 6.1 Sol / 6 Luna
GEMINI_API_KEY=              # Google Gemini: 3.8 Flash, 3.5 Flash-Lite
XAI_API_KEY=                 # xAI: Grok 4.7
DEEPSEEK_API_KEY=            # DeepSeek: V4 Pro, V4.1 Flash
MOONSHOT_API_KEY=            # Moonshot Kimi: K3, K2.6
DASHSCOPE_API_KEY=           # Alibaba Qwen: 3.8 Max, 3.7 Plus, 3.8 Flash (ANALYST_QWEN_BASE_URL for non-Singapore regions)
OPENROUTER_API_KEY=          # OpenRouter: also set ANALYST_OPENROUTER_MODELS="vendor/model,..."
ANALYST_OPENROUTER_MODELS=

# Any other OpenAI-compatible endpoint (gateway, local model server):
ANALYST_OPENAI_API_KEY=
ANALYST_OPENAI_BASE_URL=
ANALYST_MODELS=              # "id,id2=Label Two,id3"

EXA_API_KEY=                  # Exa (exa.ai): real web_search tool for the Analyst and Desk scouts on any provider; unset -> no web_search tool offered

# Server default, used when a query names no provider/model/effort.
ANALYST_PROVIDER=            # anthropic (default) | deepseek | moonshot | google | openai-platform | xai | qwen | openrouter | openai-compatible
DESK_ANALYST_MODEL=          # model for the default provider
ANALYST_API_KEY=             # default provider's key (legacy single-provider setting)
ANALYST_BASE_URL=            # default provider's base URL (required for openai-compatible)
ANALYST_EFFORT=              # low|medium|high|xhigh|max — default provider's effort when a query picks none

# Desk (agentic portfolio desk, /desk). Anthropic-first: with an Anthropic
# key the PM runs Claude Opus 5.5 and scouts Claude Sonnet 5.5, whatever
# ANALYST_PROVIDER says; otherwise the PM runs DESK_ANALYST_MODEL above (any
# vendor). Trades a paper book behind
# the governor. Needs db/migrations/003_desk.sql. All optional; defaults
# shown in brackets.
DESK_SCOUT_MODEL=            # scouts' model [claude-sonnet-5-5 with an Anthropic key, else DESK_ANALYST_MODEL]
DESK_SCOUT_PROVIDER=         # scouts' provider when no Anthropic key, any id resolveChosenProvider accepts [the analyst's provider]
DESK_ANTHROPIC_FIRST=        # false: drop Anthropic-first and follow ANALYST_PROVIDER / DESK_SCOUT_PROVIDER [true]
DESK_APPROVAL=               # auto | manual [auto]: manual queues every entry for approval
DESK_PAPER_EQUITY=           # paper starting equity, USD [10000]
DESK_VENUE=                  # paper | hl-testnet [paper]; mainnet is refused
DESK_HL_SECRET_KEY=          # hl-testnet: API (agent) wallet private key from app.hyperliquid-testnet.xyz/API
DESK_HL_ACCOUNT=             # hl-testnet: the account that agent wallet trades for [the key's own address]
DESK_HL_LEVERAGE=            # hl-testnet: cross leverage set before entries [3]
DESK_HL_SLIPPAGE_PCT=        # hl-testnet: IOC price through the mark, % [1]
DESK_WATCHLIST=              # coins the tick always watches [BTC,ETH,SOL,HYPE]
DESK_WATCH_ADDRESS=          # a Hyperliquid address to monitor read-only (no keys)
DESK_MAX_RISK_PCT=           # risk per trade, % of equity [0.5]
DESK_MAX_OPEN_RISK_PCT=      # sum of open stop risk [2]
DESK_MAX_GROSS_LEVERAGE=     # gross notional / equity [2]
DESK_MAX_COIN_LEVERAGE=      # one coin's notional / equity [1]
DESK_MAX_POSITIONS=          # [4]
DESK_MIN_RR=                 # minimum reward:risk at the live mark [1.5]
DESK_MIN_STOP_PCT=           # [0.5]
DESK_MAX_STOP_PCT=           # [15]
DESK_DAILY_LOSS_PCT=         # day loss that blocks entries until 00:00 UTC [2]
DESK_MIN_CONFIDENCE=         # low | medium | high [medium]
DESK_MAX_CYCLES_PER_DAY=     # autonomous agent runs per UTC day [8]
DESK_CYCLE_COOLDOWN_MIN=     # minutes between trigger-fired runs [60]
DESK_REVIEW_HOURS=           # scheduled full review every N hours, 0 = off [8]
DESK_APPROVAL_TTL_MIN=       # pending approvals expire after [120]
DESK_CYCLES_URL=             # hl-cycles deployment origin, for on-chain/cycle context
DESK_TELEGRAM_BOT_TOKEN=     # alerts + Approve/Reject buttons + commands
DESK_TELEGRAM_CHAT_ID=       # the only chat the bot obeys
DESK_TELEGRAM_WEBHOOK_SECRET= # set to use the /api/desk/telegram webhook instead of worker polling
DESK_DISCORD_WEBHOOK_URL=
DESK_ALERT_WEBHOOK_URL=      # generic JSON POST per alert
DESK_WORKER_TICK_SEC=        # scripts/desk-worker.ts tick interval [60]
APP_URL=                     # public origin, for links in alerts

# Lab (heuristic research engine, /lab, /api/lab/*, /api/mcp). See LAB.md.
LAB_API_TOKEN=               # comma-separated bearer tokens for /api/lab/* and /api/mcp (unset -> session cookie only)
LAB_SEARCH_DEADLINE_MS=      # server-side search deadline, ms [50000]; local CLI/stdio: none unless set
LAB_ALLOWED_ORIGINS=         # extra browser Origins allowed on /api/mcp, comma-separated (APP_URL and localhost always allowed; requests without Origin pass)
LAB_URL=                     # CLI/stdio MCP: deployed origin to proxy to (unset -> run the lab in-process)
LAB_STORE_FILE=              # local CLI/stdio run store [~/.hypertrade/lab.json]
