    "react": "^19.0.0-rc-20250804",
    "react-dom": "^19.0.0-rc-20250804",
    "react-router": "^7.0.1",
    "recharts": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vite": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.10",
    "@tailwindcss/vite": "^4.0.10",
    "typescript": "^5.7.2",
    "@types/react": "^19.0.0",
